rules_version = '2';

// 그마 설정집 앱 — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules)에 이 내용을 그대로 붙여 넣고 게시한다.
//
// 역할: reader(독자) · writer(작가) · owner(주인)
// 주인은 이메일로 정한다. 공개 저장소라서 이메일 대신 소문자 이메일의 SHA-256 해시만 적는다.
//   해시 만들기: printf '%s' '이메일' | sha256sum

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
           == 'a4e74d11e6c9b102ad3d4f8735ef8b9a556de39e5ae525b62d73511be9c948ec';
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isWriter() {
      return isOwner()
        || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && myRole() in ['writer', 'owner']);
    }

    // 가입한 사람. 자기 문서는 자기가 만들고(독자로), 역할은 주인만 바꾼다.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.role == 'reader'
            || (request.resource.data.role == 'owner' && isOwner()));

      allow update: if
        // 주인이 다른 사람의 역할을 독자·작가로 바꾼다
        (isOwner() && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['reader', 'writer'])
        // 주인 계정이 자기 문서를 주인으로 올린다
        || (isOwner() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'owner');

      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // Gemini 키 · 모델 · 실명 보기 코드. 작가 이상만 읽고, 주인만 쓴다.
    match /secrets/{doc} {
      allow read: if isWriter();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['geminiKey', 'geminiModel', 'shareCode']);
    }

    // 그 밖은 모두 막는다
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
